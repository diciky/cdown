{
  "name": "cdown",
  "version": "0.3.0",
  "description": "CDown - 极速多线程下载器 (Electron)",
  "main": "src/main/main.js",
  "author": "diciky <diciky.zl@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron . --no-sandbox",
    "start:lowgpu": "electron . --no-sandbox --disable-gpu",
    "cli": "node scripts/engine-cli.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux",
    "bundle:aria2": "node scripts/bundle-aria2.js",
    "test": "node scripts/test-all.js",
    "test:bt": "node scripts/bt-queue-test.js"
  },
  "build": {
    "appId": "com.cdown.app",
    "productName": "CDown",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      "bin/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CDown"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jimp": "^0.22.12",
    "png-to-ico": "^3.0.2"
  }
}